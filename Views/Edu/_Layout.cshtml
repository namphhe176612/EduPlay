@model EduPage
@{Layout=null; var p=Model.Page; var focus=new[]{"slides","flashcards","quiz","links","case","case-results","video","mock","study-pack","export","topup"}.Contains(p); string L(string page)=>Model.Preview?"/edu/preview/"+page:"/edu/"+page; var titles=new Dictionary<string,string>{{"today","Hôm nay"},{"courses","Môn của tôi"},{"tools","Công cụ"},{"vault","Kho của tôi"},{"progress","Tiến độ ôn tập"},{"wallet","Ví & bảng giá coin"},{"pricing","Bảng giá coin"},{"files","Tài liệu riêng"},{"settings","Cài đặt"},{"plan","Lộ trình ôn thi"},{"admin","Tổng quan"},{"admin-review","Duyệt nội dung"},{"admin-reports","Báo lỗi nội dung"},{"admin-gaps","Thiếu nội dung"},{"admin-slides","Thư viện slide"},{"admin-cases","Thư viện case"},{"admin-users","Người dùng & coin"},{"admin-pricing","Bảng giá"},{"admin-finance","Tài chính & chi phí AI"},{"admin-roles","Phân quyền"}}; }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@(titles.GetValueOrDefault(p,"Ôn tập")) · EduPlay</title><meta name="description" content="EduPlay — trợ lý ôn tập cho sinh viên. Ôn bài từ slide, tự kiểm tra và áp dụng vào tình huống."><script src="/js/edu-preferences.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/edu.css" asp-append-version="true"><script src="/js/edu.js" asp-append-version="true" defer></script></head>
<body class="@(focus?"focus":"") @(Model.IsAdmin?"admin-theme":"")" data-preview="@Model.Preview.ToString().ToLower()">
<a class="skip" href="#content">Đến nội dung chính</a>
@if(!focus){
<aside class="rail"><a class="logo" href="@L(Model.IsAdmin?"admin":"today")"><span class="sun">☀</span><span>Edu<span class="gold">Play</span>@if(Model.IsAdmin){<small>Admin</small>}</span></a>
@if(Model.IsAdmin){<p class="rail-caption">Đội nội dung · không dành<br>cho người học</p>}
<nav aria-label="Điều hướng chính">
@foreach(var (key,label,icon) in (Model.IsAdmin?new[]{("admin","Tổng quan","⌂"),("admin-review","Duyệt nội dung","✓"),("admin-reports","Báo lỗi","⚑"),("admin-gaps","Thiếu nội dung","☼"),("admin-slides","Thư viện slide","▣"),("admin-cases","Thư viện case","◎")}:new[]{("today","Hôm nay","⌂"),("courses","Môn của tôi","▥"),("tools","Công cụ","☼"),("vault","Kho của tôi","▤"),("progress","Tiến độ ôn tập","⊞")})){
<a class="@(p==key || key=="vault"&&p=="files" || key=="progress"&&p=="plan"?"active":"")" href="@L(key)"><span>@icon</span>@label</a>}
@if(Model.IsAdmin){<div class="nav-caption">SUPER ADMIN</div>@foreach(var key in new[]{"admin-users","admin-pricing","admin-finance","admin-roles"}){<a class="@(p==key?"active":"")" href="@L(key)"><span>◇</span>@titles[key] <small>♙</small></a>}<p class="privacy-note">Tài liệu riêng của người học được bảo vệ. Admin chỉ xem thống kê.</p>}
</nav><div class="rail-bottom"><a class="profile-chip" href="@L("settings")"><span class="avatar">@(Model.Name.Length>0?Model.Name[..1]:"T")</span><span><b>@Model.Name.Split(' ').Last()</b><small>@(Model.IsAdmin?"Đội nội dung":$"{Model.Balance} coin ví")</small></span><span>›</span></a><div class="rail-links"><a href="@L("wallet")">Ví & bảng giá coin</a><a href="@L("settings")">Cài đặt</a></div>@if(!Model.Preview){<form action="/edu/logout" method="post">@Html.AntiForgeryToken()<button class="text-button">Đăng xuất</button></form>}</div></aside>}
<div class="workspace">
@if(Model.Preview){<div class="preview-banner">BẢN XEM GIAO DIỆN · Dữ liệu học mẫu <a href="/edu/register">Tạo tài khoản để lưu tiến độ →</a></div>}
@if(!focus){<header class="workspace-header"><div><p class="eyebrow">@(Model.IsAdmin?"Khu vận hành EduPlay":p=="today"?$"Chào {Model.Name.Split(' ').Last()} · Mỗi ngày một chút tiến bộ":"Học từ slide của bạn")</p><h1>@(titles.GetValueOrDefault(p,p=="onboarding"?"Bạn đang học môn gì?":"Tìm kiếm"))</h1></div><div class="header-actions"><form action="@L("search")" class="search"><span>⌕</span><input name="q" aria-label="Tìm khái niệm" placeholder="Tìm khái niệm trong slide của bạn…" value="@Model.Query"></form>@if(!Model.IsAdmin){<a class="balance" href="@L("wallet")">⊙ @Model.Balance coin</a><a class="button gold-button small" href="@L("topup")">+ Nạp</a>}</div></header>}
<main id="content">@if(TempData["EduNotice"] is string n){<div class="notice" role="status">✓ @n</div>}@if(TempData["EduError"] is string e){<div class="notice error" role="alert">@e</div>}@RenderBody()</main>
@if(!focus){<footer class="workspace-footer">EduPlay <span>Ôn đúng bài. Hiểu sâu hơn mỗi ngày.</span><a href="@L("tools")">Khám phá công cụ ↗</a></footer>}
</div><div class="display-preferences" aria-label="Giao diện và ngôn ngữ"><button type="button" data-theme-toggle aria-label="Đổi giao diện">☀ / ☾</button><select data-language aria-label="Ngôn ngữ"><option value="vi">Tiếng Việt</option><option value="en">English</option></select></div><div class="toast" role="status" aria-live="polite"></div>
<dialog id="report-dialog"><form action="/edu/report" method="post">@Html.AntiForgeryToken()<header><h2>⚑ Báo cáo AI</h2><button type="button" data-close-dialog aria-label="Đóng">×</button></header><input type="hidden" name="contentId" id="report-content"><p class="muted">Báo thông tin sai trong câu hỏi, đáp án, giải thích hoặc nội dung ôn tập. Đội nội dung sẽ đối chiếu với slide nguồn.</p>@foreach(var (value,label) in new[]{("WrongGrading","Đáp án đúng bị chấm sai"),("ExplanationMismatch","Giải thích không khớp với slide"),("MissingSource","Thiếu nguồn hoặc sai số slide"),("Unclear","Nội dung khó hiểu / lỗi chính tả"),("Other","Lý do khác")}){<label class="option"><input type="radio" name="reason" value="@value" required>@label</label>}<input type="hidden" name="returnUrl" id="report-return"><textarea maxlength="2000" name="details" placeholder="Mô tả thêm (không bắt buộc)"></textarea><div class="spread"><small class="gold">Báo đúng lỗi: +5 coin sau xác nhận</small><button class="button">Gửi báo cáo</button></div><p class="muted tiny">Kiểm tra trong 48 giờ. Coin chỉ được thưởng khi lỗi được xác nhận.</p></form></dialog>
@Html.AntiForgeryToken()
</body></html>
