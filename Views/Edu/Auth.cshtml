@model EduPage
@{Layout=null; bool reg=Model.Page=="register";}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@(reg?"Đăng ký":"Đăng nhập") · EduPlay</title><script src="/js/edu-preferences.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/edu.css" asp-append-version="true"><script src="/js/edu.js" asp-append-version="true" defer></script></head><body class="auth-body"><div class="ambient orb-one"></div><div class="ambient orb-two"></div><div class="ambient square"></div>
<div class="auth-top"><a class="logo" href="/edu/preview/today"><span class="sun">☀</span><span>Edu<span class="gold">Play</span></span></a><a href="/edu/preview/today">Khám phá giao diện ↗</a></div>
<main class="auth-card @(reg?"register-card":"")">
<section class="auth-form"><div class="spread"><h1>@(reg?"Tạo tài khoản":"Đăng nhập")</h1>@if(reg){<span class="step"><i></i><i></i> Bước 1/2</span>}</div><p class="muted auth-sub">@(reg?"Bắt đầu hành trình ôn tập của bạn.":"Ôn tiếp bài trên lớp của bạn")</p>
<div class="socials"><button type="button" data-unavailable="Google OAuth chưa được cấu hình." aria-label="Đăng nhập Google">G</button><button type="button" data-unavailable="Facebook OAuth chưa được cấu hình." aria-label="Đăng nhập Facebook">f</button><button type="button" data-unavailable="Đăng nhập Microsoft chưa được cấu hình." aria-label="Đăng nhập Microsoft">M</button></div><div class="divider"><span>hoặc dùng email</span></div>
<div asp-validation-summary="All" class="validation" role="alert"></div>
<form method="post" action="/edu/@(reg?"register":"login")">@Html.AntiForgeryToken()
<div class="@(reg?"form-grid":"form-stack")">@if(reg){<label>Họ và tên <em>*</em><input name="FullName" required maxlength="100" placeholder="Nguyễn Thu Trang" autocomplete="name" value="@(Context.Request.HasFormContentType?Context.Request.Form["FullName"].ToString():"")"></label>}
<label>Email <em>*</em><input type="email" name="Email" required placeholder="ten@email.com" autocomplete="email" value="@(Context.Request.HasFormContentType?Context.Request.Form["Email"].ToString():"")"></label>
<label>Mật khẩu <em>*</em><span class="password-field"><input type="password" name="Password" required minlength="8" maxlength="128" placeholder="@(reg?"Tối thiểu 8 ký tự":"Nhập mật khẩu")" autocomplete="@(reg?"new-password":"current-password")"><button type="button" data-password aria-label="Hiện mật khẩu">◎</button></span></label>
@if(reg){<label>Nhập lại mật khẩu <em>*</em><span class="password-field"><input type="password" name="ConfirmPassword" required minlength="8" placeholder="Nhập lại" autocomplete="new-password"><button type="button" data-password aria-label="Hiện mật khẩu">◎</button></span></label>}</div>
@if(reg){<fieldset class="school-fields"><legend>BẠN ĐANG HỌC</legend><div class="form-grid"><label>Trường <em>*</em><select name="University"><option>FPT University</option></select></label><label>Kỳ hiện tại <em>*</em><select name="Semester">@for(int i=1;i<=9;i++){<option value="@i" selected="@(i==4)">Kỳ @i</option>}</select></label></div><label>Bạn có học chuyên ngành Marketing không?</label><div class="segmented"><label><input type="radio" name="Marketing" value="true" checked> Có, Marketing</label><label><input type="radio" name="Marketing" value="false"> Ngành khác</label></div><small class="muted">Ngành khác vẫn đăng ký được. Nội dung đang mở thử cho Marketing.</small></fieldset><div class="form-grid"><label>Bạn biết EduPlay qua đâu?<select name="Source"><option>Facebook</option><option>Bạn bè</option><option>Giảng viên</option><option>Khác</option></select></label><label>Mã giới thiệu (nếu có)<input name="Referral" placeholder="Mã của bạn bè"></label></div><label class="check"><input type="checkbox" name="MarketingConsent" value="true">Nhận email nhắc học, môn mới và ưu đãi coin</label><label class="check"><input type="checkbox" name="AcceptTerms" value="true" required>Tôi đồng ý Điều khoản sử dụng và Chính sách bảo mật</label>}
else {<div class="spread"><label class="check"><input type="checkbox" name="Remember" value="true" checked>Ghi nhớ đăng nhập</label><button type="button" class="text-button" data-unavailable="Đặt lại mật khẩu qua email cần cấu hình máy chủ gửi thư. Liên hệ quản trị viên để được hỗ trợ.">Quên mật khẩu?</button></div>}
<button class="button auth-submit" type="submit">@(reg?"Tiếp tục: chọn môn →":"Đăng nhập")</button></form>
</section><aside class="auth-brand"><a class="logo" href="/edu/preview/today"><span class="sun">☀</span><span>Edu<span class="gold">Play</span></span></a><p class="brand-tag">TRỢ LÝ ÔN TẬP CHO SINH VIÊN</p><div class="floating-tag tag-one"><small>FLASHCARD</small><strong>Rebranding</strong></div><div class="floating-tag tag-two"><small>TỰ KIỂM TRA</small><strong>Price · 4P</strong></div><div class="floating-coin">⊙</div><div class="brand-welcome"><h2>@(reg?"Chào mừng quay lại!":"Chào bạn mới!")</h2><p>@(reg?"Đã có tài khoản? Đăng nhập để ôn tiếp bài trên lớp và xem mình đã sẵn sàng cho kỳ thi chưa.":"Chưa có tài khoản? Đăng ký miễn phí để ôn đúng bài bạn đang học trên lớp, kèm 20 coin chào mừng.")</p><a class="button outline-light" href="/edu/@(reg?"login":"register")">@(reg?"Đăng nhập":"Đăng ký")</a></div></aside></main><div class="display-preferences" aria-label="Giao diện và ngôn ngữ"><button type="button" data-theme-toggle aria-label="Đổi giao diện">☀ / ☾</button><select data-language aria-label="Ngôn ngữ"><option value="vi">Tiếng Việt</option><option value="en">English</option></select></div><div class="toast" role="status" aria-live="polite"></div></body></html>
