@model EduPage
@using System.Text.Json
@{Layout="_Layout";var p=Model.Page;string L(string page)=>Model.Preview?"/edu/preview/"+page:"/edu/"+page;string T(Dictionary<string,object?> r,string k,string f="")=>EduPage.Text(r,k,f);long N(Dictionary<string,object?> r,string k)=>EduPage.Number(r,k);bool vip=new[]{"video","plan","mock","study-pack","export"}.Contains(p);var conceptNames=new[]{"Skimming","Value-based","Psychological","Penetration","Bundle"};}
@if(new[]{"slides","flashcards","quiz","links","case","case-results","video","mock","study-pack","export","topup"}.Contains(p)){
<header class="session-header"><a href="@L("today")" class="exit">× <span>Thoát</span></a><div><p class="eyebrow orange">@(p switch{"flashcards"=>"ÔN SAU BUỔI HỌC · 3 PHÚT","quiz"=>"TỰ KIỂM TRA · 10 PHÚT","case" or "case-results"=>"ÁP DỤNG VÀO CASE · 20 PHÚT","slides"=>"XEM SLIDE GỐC","links"=>"ÔN NHANH · NỐI KHÁI NIỆM","topup"=>"VÍ COIN · NẠP COIN",_=>"EDUPLAY VIP · SẮP CÓ"})</p><b>@(p switch{"flashcards"=>"Flashcard · MKT101 Chương 4","quiz"=>"Mình đã hiểu Chương 4 chưa?","slides"=>"MKT101 · Chương 4 · Pricing Strategies","links"=>"Nối các khái niệm Chương 4","case"=>"Vận dụng chiến lược giá · tình huống giả định","case-results"=>"Kết quả case của bạn","topup"=>"Nạp coin",_=>"Hiểu bài và ôn thi cùng EduPlay"})</b></div><div class="session-progress"><div class="progress-track"><i id="session-progress"></i></div><small id="session-count">@(vip?"VIP · sắp có":"Bắt đầu")</small></div></header>}
@if(vip){<div class="vip-banner"><span class="badge gold-badge">♛ VIP · sắp có</span><span>Bản xem trước của gói mở rộng EduPlay VIP. Chưa mở, chưa có giá; mở sau giai đoạn pilot.</span><form action="/edu/waitlist" method="post">@Html.AntiForgeryToken()<input type="hidden" name="feature" value="@(p switch{"video"=>"Video90","plan"=>"StudyPlan","mock"=>"MockExam","study-pack"=>"StudyPack",_=>"PdfExport"})"><button class="button gold-button small" disabled="@Model.Preview">♧ Nhận thông báo khi mở</button></form></div>}
@switch(p){
case "today":
@if(!Model.Preview && Model.Data.Count==0){<section class="panel empty"><span>▥</span><h2>Bạn chưa chọn môn nào</h2><p>Chọn môn đang học trên lớp để EduPlay đưa đúng slide và lịch ôn.</p><a class="button gold-button" href="@L("onboarding")">Chọn môn →</a></section>}else{
<section class="hero-study"><div><p class="eyebrow gold">TRÊN LỚP HÔM NAY · ÔN ĐÚNG BÀI CỦA BẠN</p><h2>@Model.S("CourseCode","MKT101") · Chương @Model.S("ChapterNumber","4"): @Model.S("ChapterTitle","Pricing Strategies")</h2><p>5 khái niệm · ôn từ slide · khoảng 3 phút</p><a class="button gold-button" href="@L("flashcards")?id=@Model.S("ChapterId","0")">Bắt đầu ôn · 3 phút →</a><small>Còn sức? <a href="@L("quiz")">Tự kiểm tra 10 phút</a> · <a href="@L("case")">Case 20 phút</a></small></div><div class="hero-concepts"><b>Khái niệm của chương</b>@if(Model.Preview){@foreach(var name in conceptNames){<div><span class="concept-circle"></span>@name<small>Chưa ôn</small></div>}}else{@foreach(var concept in Model.Extra){<div><span class="concept-circle"></span>@T(concept,"EnglishTerm")<small>@(Convert.ToDecimal(concept["Mastery"])>=80?"Đã vững":"Cần ôn")</small></div>}@if(Model.Extra.Count==0){<p class="muted tiny">Chưa có nội dung cho chương này. Bạn có thể thêm slide riêng.</p>}}</div></section>
<div class="grid two dashboard-lower"><section class="panel"><p class="eyebrow orange">CHUẨN BỊ CHO KỲ THI</p><h3>Học chắc hơn từng chương</h3><p class="muted">Lưu lịch thi và theo dõi mức sẵn sàng từ kết quả ôn tập.</p><div class="chips"><span>Penetration</span><span>Bundle</span><span>Pricing</span></div><a class="text-link" href="@L("progress")">Xem tiến độ ôn tập →</a><a class="tiny" href="@L("plan")">Lộ trình ôn thi <span class="badge">VIP</span></a></section><section class="panel"><h3>Trên lớp có chỗ chưa hiểu?</h3><form action="@L("search")" class="ask-input"><input name="q" placeholder="Ví dụ: Penetration khác Skimming ở điểm nào?" aria-label="Khái niệm cần tìm"><button class="button small">Tìm</button></form><p class="muted tiny">Tìm khái niệm và quay về slide nguồn của bài học.</p><a class="text-link" href="@L("tools")">☼ Xem tất cả công cụ: ôn tập, case, lộ trình… →</a></section></div>
}
<section class="next-step"><span class="sun">☀</span><div><b>Mỗi lần ôn, hiểu thêm một chút.</b><p class="muted">Chọn môn và lịch học để EduPlay đồng hành đúng nhịp lớp của bạn.</p></div><a class="button subtle" href="@L("onboarding")">Chọn môn học →</a></section>
break;
case "tools":
<section class="panel purpose"><h3>Bạn đang cần gì?</h3><div class="purpose-tabs"><a href="#understand">▤ Mình chưa hiểu bài</a><a href="#practice">ϟ Mình muốn luyện</a><a href="#cases">◎ Áp dụng case thật</a><a href="@L("files")">▣ Tài liệu của mình</a></div><p class="muted tiny">Học theo slide luôn miễn phí, chỉ trả coin khi dùng AI. <a href="@L("wallet")#coin-packages">Bảng giá coin →</a></p></section>
@foreach(var group in new[]{("understand","Hiểu bài","Trên lớp chưa rõ chỗ nào thì xem lại ở đây",new[]{("slides","Xem slide gốc","Slide giảng viên, tô sáng khái niệm, ghi chú riêng","▣","0 coin"),("search","Gợi ý slide","Tìm khái niệm và quay lại nguồn trong bài học","☼","1 coin"),("search","Từ điển + trợ từ AI","Thuật ngữ tiếng Anh kèm nghĩa tiếng Việt","▥","10 lượt/ngày miễn phí"),("video","Video 90 giây","AI giảng lại một khái niệm, có nguồn","▷","VIP · sắp có")}),
("practice","Luyện tập","Ôn ngắn mỗi ngày để nhớ lâu",new[]{("flashcards","Ôn lặp lại","Thẻ đến hạn hôm nay, ôn đúng lúc sắp quên","⟳","0 coin"),("quiz","Tự kiểm tra","Câu hỏi từ bài học, có giải thích và số slide","ϟ","0 coin"),("links","Nối khái niệm","Nhìn nhanh sự liên quan giữa các khái niệm","♧","0 coin"),("quiz","Học sâu","Luyện câu hỏi và quay lại phần còn yếu","◎","6 câu/ngày miễn phí")}),
("cases","Case thật","Áp dụng lý thuyết vào tình huống doanh nghiệp",new[]{("case","Chơi case có sẵn","Nhận diện, giải thích, liên hệ slide và vận dụng","◎","0 coin"),("files","Dựng case từ slide","Tải tài liệu riêng để chuẩn bị nội dung học","☼","3 coin · khi AI được cấu hình"),("case","Chất vấn AI","Hỏi sâu về tình huống, bám nguồn bài học","▤","3 lượt/case miễn phí")}),
("exam","Chuẩn bị thi","Gói mở rộng EduPlay VIP · mở sau giai đoạn pilot",new[]{("plan","Lộ trình ôn thi","Lịch ôn mỗi ngày, thích ứng với tiến độ của bạn","▦","VIP · sắp có"),("mock","Thi thử","Làm bài theo cấu trúc giảng viên công bố","◷","VIP · sắp có"),("study-pack","Bộ ôn theo đề cương","Đối chiếu đề cương với các chương slide","▯","VIP · sắp có"),("export","Xuất đề cương PDF","Gom trọng tâm, câu sai và ghi chú thành file","↓","VIP · sắp có")} )}){
<section class="tool-section" id="@group.Item1"><h2>@group.Item2 <small>@group.Item3</small></h2><div class="tool-grid">@foreach(var tool in group.Item4){<a class="tool-card" href="@L(tool.Item1)"><div class="tool-art"><span>@tool.Item4</span><small>@(tool.Item5.Contains("VIP")?"VIP · sắp có":"Dùng ngay")</small></div><div class="tool-copy"><h3>@tool.Item2</h3><p>@tool.Item3</p><footer><small>@tool.Item5</small><b>Mở →</b></footer></div></a>}</div></section>}
break;
case "courses":
<div class="course-tabs">@foreach(var c in Model.Courses){<a class="button @(T(c,"Code")== (Model.Query??"MKT101")?"":"dark-button")" href="@L("courses")?q=@T(c,"Code")">@T(c,"Code")</a>}<a class="button dashed" href="@L("onboarding")">+ Thêm môn</a></div>
<div class="grid main-side"><section class="panel"><div class="spread"><div><p class="eyebrow orange">@(Model.Query??"MKT101") · KỲ 4</p><h2>@(Model.Query is "MKT201" or "MKT304" ? "Nội dung đang được bổ sung":"Principles of Marketing")</h2></div><span class="badge">▣ Theo slide giảng viên</span></div><p class="muted">Các chương xếp theo tuần học trên lớp. Ôn và áp dụng bài đã học.</p>@foreach(var ch in Model.Chapters){<div class="chapter-row @(N(ch,"ChapterNumber")==4?"current":"")"><small>Tuần @T(ch,"WeekFrom")–@T(ch,"WeekTo")</small><div><h3>Chương @T(ch,"ChapterNumber") · @T(ch,"Title")</h3><small class="@(N(ch,"ChapterNumber")==4?"orange":"muted")">@(N(ch,"ChapterNumber")==4?"Lớp đang học tuần này":"Ôn theo nhịp của bạn")</small></div><div class="row-actions"><a class="button small subtle" href="@L("flashcards")?id=@T(ch,"ChapterId")">Ôn lại</a><a class="button small brown" href="@L("quiz")?id=@T(ch,"ChapterId")">Tự kiểm tra</a>@if(N(ch,"ChapterNumber")==3){<a class="button small" href="@L("case")">Case</a>}</div></div>}@if(Model.Chapters.Count==0){<div class="empty"><span>▥</span><h3>Thư viện môn này đang chuẩn bị</h3><p>Tải slide riêng để lưu và đọc bài của bạn.</p><a class="button" href="@L("files")">Thêm tài liệu</a></div>}</section><aside class="stack"><section class="panel"><h3>Lịch của môn</h3><div class="calendar-line"><span class="date-block">◷</span><div><b>Buổi học và ngày thi</b><p class="muted tiny">Cập nhật theo lịch học của bạn.</p></div></div><a href="@L("onboarding")">Sửa lịch học →</a></section><section class="panel"><h3>Tài liệu bạn thêm cho môn này</h3><p class="muted">Slide và ghi chú riêng chỉ mình bạn xem.</p><a href="@L("files")">+ Thêm slide / ghi chú</a></section></aside></div>
break;
case "onboarding":
<div class="onboard-grid"><section class="panel"><div class="spread"><h2>Bạn đang học môn gì?</h2><span class="step"><i></i><i class="on"></i>Bước 2/2</span></div><p class="muted">Chọn môn và lịch học để ôn đúng bài trên lớp.</p><form action="/edu/onboarding" method="post">@Html.AntiForgeryToken()<h3>1 · Chọn môn có sẵn trong thư viện</h3><div class="course-select">@foreach(var c in Model.Courses){<label class="course-option"><input type="checkbox" name="courseIds" value="@T(c,"CourseId")" checked="@(T(c,"Code")=="MKT101")" disabled="@(!Convert.ToBoolean(c["IsAvailable"]))"><span><b>@T(c,"Code")</b><small>@T(c,"Name")</small><small>@(Convert.ToBoolean(c["IsAvailable"])?"Có sẵn · nội dung mẫu":"Đang chuẩn bị")</small></span></label>}</div><h3>2 · Môn chưa có? Thả slide của bạn vào đây</h3><a class="upload-zone compact" href="@L("files")"><span>↥</span><b>Kéo thả file PDF hoặc chọn từ máy</b><small>Thêm tài liệu riêng ở Kho của tôi · tối đa 20 MB, 40 trang</small></a><p class="muted tiny">File riêng không đưa vào thư viện chung. 15 trang đầu miễn phí.</p><h3>3 · Lịch học của bạn</h3><div class="form-grid"><label>Lớp đang học tới<select name="chapter"><option value="1">Chương 1 · What is Marketing?</option><option value="2">Chương 2 · Environment</option><option value="3">Chương 3 · Products & Brands</option><option value="4" selected>Chương 4 · Pricing</option></select></label><label>Ngày thi giữa kỳ<input type="date" name="examDate"></label></div><label>Buổi học trong tuần</label><div class="weekdays">@for(int d=1;d<=7;d++){<label><input type="checkbox" name="weekdays" value="@d">@(d==7?"CN":"Thứ "+(d+1))</label>}</div><div class="spread spaced"><a href="@L("today")">← Quay lại</a><button class="button" disabled="@Model.Preview">Bắt đầu học →</button></div></form></section><aside class="onboard-brand"><a class="logo" href="@L("today")"><span class="sun">☀</span>Edu<span class="gold">Play</span></a><p class="brand-tag">TRỢ LÝ ÔN TẬP CHO SINH VIÊN</p><div><h2>Sắp xong rồi, @Model.Name.Split(' ').Last()!</h2><p>Bạn sẽ nhận được:</p><ul class="benefits"><li>Ôn đúng chương lớp đang học</li><li>Nhớ lâu hơn bằng flashcard và tự kiểm tra</li><li>20 coin chào mừng</li></ul></div></aside></div>
break;
case "slides":
<div class="slide-workspace"><aside class="slide-thumbnails">@foreach(var s in Model.Items){<a href="@L("slides")?id=@T(s,"SlideId")" class="@(T(s,"SlideId")==Model.S("SlideId")?"selected":"")"><small>@T(s,"PageNumber")</small><div><i></i><i></i><i></i><i></i></div></a>}</aside><section><article class="slide-canvas"><p class="eyebrow">Chapter 4 · Pricing Strategies</p><h2>@(Model.S("PageNumber")=="2"?"Market-skimming Pricing":"New-Product Pricing Strategies")</h2><p class="slide-text">@Model.S("ExtractedText","Chưa có slide. Hãy thêm tài liệu của bạn.").Replace("\\n","\n")</p><span class="sample-label">@Model.S("OriginalName")</span></article><div class="spread spaced"><a class="button dark-button small" href="@L("courses")">← Về chương</a><button class="button dark-button small" type="button" data-highlight>Tô sáng</button><button class="button dark-button small" type="button" data-focus-note>▤ Ghi chú</button></div></section><aside class="stack"><section class="panel"><h3>Khái niệm trên slide này</h3><p class="muted tiny">Thuật ngữ tiếng Anh kèm nghĩa tiếng Việt</p><div class="definition"><b>Penetration Pricing</b><p>Định giá thâm nhập: đặt giá thấp lúc ra mắt để thu hút khách và tăng thị phần.</p><a href="@L("flashcards")">+ Ôn bằng flashcard →</a></div></section><section class="panel"><h3>▤ Ghi chú của bạn</h3><form action="/edu/note" method="post">@Html.AntiForgeryToken()<input type="hidden" name="slideId" value="@Model.S("SlideId")"><textarea id="slide-note" name="note" placeholder="Ghi lại điều bạn muốn nhớ…">@(Model.Extra.Count>0?T(Model.Extra[0],"Note"):"")</textarea><button class="button small" disabled="@Model.Preview">Lưu ghi chú</button></form><p class="muted tiny">Chỉ mình bạn xem. Ghi chú giúp bạn ôn bài sau này.</p></section><section class="panel"><h3>Đang dùng slide này ở</h3><a class="list-link" href="@L("flashcards")">Flashcard Chương 4 <span>→</span></a><a class="list-link" href="@L("quiz")">Tự kiểm tra Chương 4 <span>→</span></a></section></aside></div>
break;
case "flashcards":
<div class="grid main-side learning-area" id="flashcard-app"><section><button class="flashcard" id="flashcard" type="button"><small class="eyebrow orange">KHÁI NIỆM · PRICING</small><h2 id="card-front">@(Model.Items.FirstOrDefault() is {} f?T(f,"Front"):"Chưa có thẻ")</h2><p id="card-back" hidden></p><small class="muted">Bấm vào thẻ hoặc nhấn Space để lật</small></button><div class="panel spaced"><button type="button" class="text-button" id="card-report" data-report disabled>⚑ Báo cáo AI</button><p class="muted tiny">Báo khi thẻ ôn tập có thông tin sai.</p></div><div class="grid two review-buttons"><button class="button brown" data-remember="false">← Chưa nhớ<small>gặp lại sau 10 phút</small></button><button class="button" data-remember="true">Nhớ rồi →<small>lên lịch ôn lần sau</small></button></div><div class="notice" id="card-complete" hidden>Đã hoàn thành lượt ôn. <a href="@L("today")">Về Hôm nay →</a></div></section><aside class="stack"><section class="panel"><p class="eyebrow">MẶT SAU KHI LẬT</p><p id="card-definition">Lật thẻ để xem định nghĩa và tự kiểm tra trí nhớ.</p><a id="card-source" href="@L("slides")">▣ MKT101 · Ch.4 · slide nguồn</a></section><section class="panel"><h3>Phiên này</h3><div class="grid two"><div class="stat-tile"><small>Nhớ rồi</small><strong id="remembered-count">0</strong></div><div class="stat-tile warm"><small>Ôn lại sau</small><strong id="forgot-count">0</strong></div></div><p class="muted tiny">Ôn lặp lại ngắt quãng: thẻ nhớ chắc được lên lịch xa dần (1 → 3 → 7 → 14 ngày).</p></section></aside></div><script type="application/json" id="flashcard-data">@Html.Raw(JsonSerializer.Serialize(Model.Items))</script>
break;
case "quiz": case "links":
<div class="notice">Bộ câu hỏi luyện tập <a class="button small" href="@L("quiz")?q=demo-five">Làm thử 5 câu mẫu →</a>@if(Model.Preview){<span> · Làm thử không cần đăng nhập; kết quả không lưu vào tài khoản.</span>}</div>
@if(Model.Preview && p=="quiz"){<script type="application/json" id="sample-question-data">@Html.Raw(JsonSerializer.Serialize(Model.Extra))</script>}
<div class="grid main-side learning-area" id="quiz-app" data-mode="@p"><section><div class="panel quiz-panel">@if(p=="links"){<div class="overtime"><b>OVERTIME</b><span>Liên kết các khái niệm từ slide</span><span id="link-streak">Chuỗi ×0</span></div><div class="concept-chain"><span>Marketing Mix</span> — <span>Price</span> — <span>?</span></div>}<p class="eyebrow orange">MKT101 · CHƯƠNG 4</p><h2 id="question-prompt">@(Model.Preview?"Mục tiêu chính của chiến lược Penetration Pricing là gì?":"Đang chuẩn bị câu hỏi…")</h2><button type="button" class="text-button" id="question-report" data-report disabled>⚑ Báo cáo AI</button><div id="question-options">@if(Model.Preview){@foreach(var label in new[]{"Giành thị phần nhanh bằng giá thấp lúc ra mắt","Bán giá cao cho nhóm khách sớm rồi giảm dần","Giữ giá ngang đối thủ","Gộp nhiều sản phẩm để bán giá ưu đãi"}){<button class="option" data-unavailable="Đăng nhập để làm bài và lưu kết quả.">@label</button>}}</div></div><div class="answer-feedback" hidden><div class="spread"><p class="eyebrow gold" id="answer-status"></p><button class="text-button" data-report>⚑ Báo cáo AI</button></div><p id="answer-explanation"></p><div class="spread"><a id="answer-source" href="@L("slides")">▣ Xem slide nguồn</a><button class="button gold-button" id="next-question">Câu tiếp →</button></div></div><section class="panel spaced" id="ai-reports" hidden aria-live="polite"><h3>Xem lại từng câu đã làm</h3><p class="muted tiny">Phân tích theo đáp án và giải thích có sẵn từ bài học; chưa gọi AI trực tiếp.</p><div id="ai-report-list"></div></section><div id="quiz-complete" class="panel empty" hidden><span>✓</span><h2>Bạn đã hoàn thành!</h2><p id="quiz-score"></p><a class="button" href="@L("progress")">Xem tiến độ →</a></div></section><aside class="stack"><section class="panel"><h3>Tiến độ phiên</h3><div class="question-dots" id="question-dots"></div><p class="muted tiny">■ Đúng <span class="orange">■ Sai · sẽ hỏi lại</span></p></section><section class="panel"><h3>Câu hỏi lấy từ đâu?</h3><p class="muted">Nội dung mẫu theo khái niệm của bài học. Mỗi câu có giải thích và liên kết slide nguồn.</p><p class="tiny">Tình huống vận dụng nằm ở phần <a href="@L("case")">Case</a>.</p></section></aside></div><script type="application/json" id="question-data">@Html.Raw(JsonSerializer.Serialize(Model.Items.Select(x=>N(x,"ContentId"))))</script>
break;
case "case":
