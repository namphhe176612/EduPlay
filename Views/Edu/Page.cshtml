case "wallet":
<div class="grid two"><section class="wallet-hero"><p class="eyebrow gold">SỐ DƯ</p><h2><span class="coin-icon">⊙</span> @Model.Balance <small>coin</small></h2><p>Coin mua lẻ, dùng bao nhiêu trả bấy nhiêu.</p><div class="row-actions"><a class="button gold-button" href="@L("topup")">+ Nạp coin</a><a class="button outline-light" href="@L("wallet")#coin-packages">Bảng giá</a></div></section><section class="panel"><div class="spread"><h3>Lượt miễn phí</h3><small class="muted">Làm mới 00:00</small></div>@foreach(var feature in Model.Extra){<div class="quota-row"><div class="spread"><b>@T(feature,"Name")</b><small>@T(feature,"FreeUnits") lượt @(T(feature,"ResetPeriod")=="PerCase"?"/ case":"/ ngày")</small></div><div class="progress-track"><i></i></div></div>}<p class="muted tiny">Hạn mức được áp dụng khi tính năng AI được cấu hình.</p></section></div><div class="grid main-side spaced"><section><div class="panel"><h3>Nhận thêm coin</h3>@foreach(var (title,desc,reward,link) in new[]{("Quà chào mừng","Khi tạo tài khoản","+20","today"),("Hoàn thành một case lần đầu","Mỗi case chỉ thưởng một lần","+1","case"),("Giữ chuỗi 7 ngày","Học liên tục mỗi ngày","+5","flashcards"),("Báo lỗi được xác nhận","Đội nội dung xác nhận đúng là lỗi","+5","quiz"),("Mời bạn cùng lớp","Sau buổi học đầu tiên của bạn bè","+10/bạn","settings")}){<a class="reward-row" href="@L(link)"><span class="item-symbol">☼</span><div><b>@title</b><small>@desc</small></div><strong class="orange">@reward</strong><span>→</span></a>}<p class="muted tiny">Một số chương trình thưởng cần được kích hoạt sau khi hoàn thiện điều kiện xác minh.</p></div><section class="panel"><h3>Lịch sử coin</h3>@foreach(var item in Model.Items){<div class="ledger-row"><small>@T(item,"CreatedAt")</small><span>@T(item,"Reason")</span><b class="@(N(item,"Amount")>0?"gold":"")">@(N(item,"Amount")>0?"+":"")@T(item,"Amount")</b></div>}@if(Model.Items.Count==0){<p class="muted">Chưa có giao dịch.</p>}</section></section><aside class="stack"><section class="panel"><h3>Coin dùng vào đâu</h3>@foreach(var (name,cost) in new[]{("Chất vấn AI (sau 3 lượt/case)","1 coin"),("Gợi ý slide","1 coin"),("Tra từ AI (sau 10 lượt/ngày)","1 coin"),("Học sâu (sau 6 câu/ngày)","1 coin/3 câu"),("Dựng case từ slide","3 coin"),("Mở tài liệu đến 40 trang","15 coin"),("Thêm 1 ô lưu","10 coin")}){<div class="price-line"><span>@name</span><b>@cost</b></div>}<p class="muted tiny">Học theo slide và chơi case có sẵn luôn miễn phí.</p></section><section class="panel blue"><span class="badge gold-badge">♛ VIP · sắp có</span><h3>EduPlay VIP sắp ra mắt</h3><p>Video 90 giây, bộ ôn theo đề cương, thi thử…</p><a class="gold" href="@L("plan")">Xem trước →</a></section></aside></div>
