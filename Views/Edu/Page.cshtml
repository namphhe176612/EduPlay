default:
@if(p.StartsWith("admin")){
<div class="stats-grid">@foreach(var (key,label) in new[]{("Users","Tài khoản đang hoạt động"),("Reviews","Nội dung chờ duyệt"),("Reports","Báo lỗi đang mở"),("Gaps","Nội dung cần bổ sung")}){<div class="panel stat"><small>@label</small><strong>@Model.S(key,"0")</strong></div>}</div>
@if(Model.Preview){<div class="notice">Bản xem bố cục quản trị. Dữ liệu vận hành chỉ hiển thị sau đăng nhập và kiểm tra quyền.</div>}
@if(p=="admin"){
<div class="pipeline">@foreach(var (step,title) in new[]{("S1","Thu thập slide"),("S3","Dựng thẻ + câu hỏi"),("S5","Duyệt case"),("S8","Kiểm duyệt"),("S12","Giám sát")}){<section class="panel"><small>@step</small><b>@title</b><span class="muted tiny">Theo dõi từ dữ liệu thực tế</span></section>}</div><div class="grid two"><section class="panel"><h3>Việc cần làm</h3>@if(Model.Items.Count==0){<div class="empty"><span>✓</span><h3>Chưa có việc đang mở</h3><p>Hàng đợi sẽ cập nhật khi có báo lỗi hoặc nội dung thiếu.</p></div>}@foreach(var item in Model.Items){<div class="history-row"><b>@T(item,"Kind")</b><p>@T(item,"Description")</p></div>}<a href="@L("admin-gaps")">Mở hàng đợi nội dung →</a></section><section class="panel"><h3>Chi phí AI theo tính năng</h3><p class="muted">Chưa có cuộc gọi AI trong database mới. Chi phí sẽ được ghi theo từng lần gọi thật.</p><a href="@L("admin-finance")">Xem tài chính và chi phí →</a></section></div>
}else if(p=="admin-review"){
<div class="grid main-side"><section class="panel"><h3>Nội dung chờ kiểm duyệt</h3>@foreach(var item in Model.Items){<article class="review-item"><p class="eyebrow orange">@T(item,"Kind") · @T(item,"Status")</p><h2>@T(item,"Title")</h2><p>@T(item,"Premise")</p><form action="/edu/admin-review" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@T(item,"ContentId")"><div class="row-actions"><button class="button" name="decision" value="Pass">Duyệt · phát hành</button><button class="button outline" name="decision" value="Revise">Yêu cầu sửa</button><button class="text-button orange" name="decision" value="Reject">Từ chối</button></div></form></article>}@if(Model.Items.Count==0){<div class="empty"><span>✓</span><h3>Không có nội dung chờ duyệt</h3><p>Nội dung mới cần được đối chiếu nguồn trước khi phát hành.</p></div>}</section><aside class="panel"><h3>Người duyệt kiểm tra</h3><ul class="check-list"><li>Số liệu khớp nguồn bài báo</li><li>Khái niệm khớp slide</li><li>Nguồn nằm trong danh sách cho phép</li><li>Đáp án có giải thích vì sao</li><li>Ngôn ngữ phù hợp sinh viên</li><li>Tình huống giả định có nhãn rõ</li></ul></aside></div>
}else if(p=="admin-reports"){
<section class="panel"><h3>Cam kết phản hồi người học trong 48 giờ</h3><div class="table-scroll"><table><thead><tr><th>Mã</th><th>Nội dung</th><th>Lý do</th><th>Trạng thái</th><th>Hạn phản hồi</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>#R-@T(item,"ReportId")</td><td>@T(item,"Title")</td><td>@T(item,"Reason")</td><td>@T(item,"Status")</td><td class="orange">@T(item,"DueAt")<form action="/edu/admin-report" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@T(item,"ReportId")"><textarea name="resolution" placeholder="Kết quả đối chiếu nguồn" required></textarea><button class="button small" name="confirmed" value="true">Xác nhận lỗi · +5 coin</button><button class="text-button" name="confirmed" value="false">Không phải lỗi</button></form></td></tr>}</tbody></table></div>@if(Model.Items.Count==0){<div class="empty"><span>⚑</span><h3>Chưa có báo lỗi</h3><p>Báo lỗi của người học sẽ được đưa vào hàng đợi này.</p></div>}</section>
}else if(p=="admin-slides"){
