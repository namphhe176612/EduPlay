}else if(p=="admin-cases"){
<section class="panel"><h3>Thư viện case</h3><div class="table-scroll"><table><thead><tr><th>Case</th><th>Doanh nghiệp</th><th>Loại</th><th>Điểm</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@T(item,"Title")</td><td>@T(item,"CompanyName")</td><td>@(T(item,"IsHypothetical")=="True"?"Giả định":"Case thật")</td><td>@T(item,"QualityScore","Chưa chấm")</td><td>@T(item,"Status")</td></tr>}</tbody></table></div><p class="muted tiny">Case thật phải có bài báo nguồn. Tình huống giả định được gắn nhãn riêng.</p></section>
}else if(p=="admin-gaps"){
<section class="panel"><h3>Hàng đợi thiếu nội dung</h3>@foreach(var item in Model.Items){<div class="history-row"><div><small class="orange">@T(item,"Kind")</small><b>@T(item,"Description")</b><small>@T(item,"Status")</small></div><form action="/edu/admin-gap" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@T(item,"GapId")"><button class="button small" disabled="@(T(item,"Status")!="Open")">Nhận việc</button></form></div>}@if(Model.Items.Count==0){<div class="empty"><span>☼</span><h3>Chưa có nội dung thiếu được ghi nhận</h3><p>Khái niệm mới, nguồn thiếu và tìm kiếm không có kết quả sẽ được theo dõi tại đây.</p></div>}</section>
}else if(p=="admin-users"){
<section class="panel"><h3>Người dùng & coin</h3><div class="table-scroll"><table><thead><tr><th>ID</th><th>Họ tên</th><th>Email</th><th>Coin</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@T(item,"UserId")</td><td>@T(item,"FullName")</td><td>@T(item,"Email")</td><td>@T(item,"Balance")</td><td>@T(item,"Status")<form action="/edu/admin-user" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@T(item,"UserId")"><button class="button small outline" name="operation" value="@(T(item,"Status")=="Locked"?"unlock":"lock")">@(T(item,"Status")=="Locked"?"Mở khóa":"Khóa")</button></form><form action="/edu/admin-user" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@T(item,"UserId")"><input type="hidden" name="operation" value="coins"><label>Điều chỉnh coin<input type="number" name="amount" min="-1000000" max="1000000" required placeholder="+ / − coin"></label><input name="reason" required placeholder="Lý do điều chỉnh"><button class="button small">Ghi sổ coin</button></form></td></tr>}</tbody></table></div></section>
}else if(p=="admin-pricing"){
<section class="panel"><h3>Gói coin</h3><table><thead><tr><th>Gói</th><th>Coin</th><th>Giá VND</th><th>Đang mở</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@T(item,"Name")</td><td>@T(item,"Coins")</td><td>@T(item,"PriceVnd")</td><td><form action="/edu/admin-price" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@T(item,"PackageId")"><label>Coin<input type="number" name="coins" min="1" value="@T(item,"Coins")" required></label><label>Giá VND<input type="number" name="priceVnd" min="1000" value="@T(item,"PriceVnd")" required></label><label class="check"><input type="checkbox" name="active" value="true" checked="@(T(item,"IsActive")=="True")">Đang mở</label><button class="button small">Lưu giá</button></form></td></tr>}</tbody></table></section>
}else if(p=="admin-finance"){
<section class="panel"><h3>Chi phí AI thực tế</h3><table><thead><tr><th>Tính năng</th><th>Số cuộc gọi</th><th>Chi phí USD</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@T(item,"FeatureCode")</td><td>@T(item,"Calls")</td><td>@T(item,"CostUsd")</td></tr>}</tbody></table>@if(Model.Items.Count==0){<p class="muted">Chưa phát sinh chi phí AI.</p>}</section>
}else if(p=="admin-roles"){
<section class="panel"><h3>Phân quyền hệ thống</h3><table><thead><tr><th>Vai trò</th><th>Số thành viên</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@T(item,"Code")</td><td>@T(item,"Members")</td></tr>}</tbody></table><form action="/edu/admin-role" method="post" class="form-grid spaced">@Html.AntiForgeryToken()<label>ID tài khoản nhân sự<input type="number" name="id" min="1" required></label><label>Vai trò<select name="role"><option>ContentEditor</option><option>ContentReviewer</option><option>SuperAdmin</option></select></label><button class="button" disabled="@Model.Preview">Cập nhật vai trò</button></form><p class="muted">Người học không có quyền truy cập khu quản trị. Phát hành nội dung yêu cầu ContentReviewer hoặc SuperAdmin.</p></section>
}
}
break;
}
