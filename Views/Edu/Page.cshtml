case "mock":
<div class="grid main-side learning-area"><section class="panel"><div class="spread"><p class="eyebrow">CÂU 12 / 30 · TRẮC NGHIỆM · CH.4</p><span class="orange tiny">⚑ Đánh dấu xem lại</span></div><h2>Một hãng sữa mới vào thị trường muốn có nhiều khách thật nhanh. Chiến lược giá nào phù hợp nhất?</h2>@foreach(var text in new[]{"Giá cao lúc ra mắt để thu hồi vốn nhanh","Giá thấp lúc ra mắt để giành thị phần nhanh","Giá theo chi phí cộng lãi cố định","Giá thay đổi theo từng nhóm khách"}){<label class="option"><input type="radio" name="mock-answer" disabled>@text</label>}<div class="spread spaced"><button class="button outline" disabled>← Câu 11</button><button class="button" disabled>Câu 13 →</button></div><p class="muted tiny">Bản xem trước. Khi thi sẽ không hiện đáp án; giải thích chỉ hiện sau khi nộp bài.</p></section><aside class="stack"><section class="panel"><h3>Bảng câu hỏi</h3><div class="question-board">@for(int d=1;d<=30;d++){<span class="@(d<12?"done":"")">@d</span>}</div></section><section class="panel"><h3>Cấu trúc đề minh họa</h3><div class="price-line"><span>Trắc nghiệm</span><b>20 câu</b></div><div class="price-line"><span>Tự luận ngắn</span><b>6 câu</b></div><div class="price-line"><span>Tình huống</span><b>4 câu</b></div><p class="muted tiny">Đề ôn theo slide. Không phải đề thi thật.</p></section></aside></div>
