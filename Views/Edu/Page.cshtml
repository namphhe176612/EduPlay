case "progress":
<div class="stats-grid">@foreach(var (key,label) in new[]{("StudyDays","Ngày đã ôn"),("Mastered","Khái niệm đã vững"),("Answers","Câu tự kiểm tra"),("Cases","Case đã áp dụng")}){<div class="panel stat"><small>@label</small><strong>@Model.S(key,"0")</strong></div>}</div><div class="grid two"><section class="panel"><h3>Sẵn sàng cho kỳ thi MKT101</h3>@foreach(var ch in Model.Chapters){<div class="readiness-row"><span>Ch.@T(ch,"ChapterNumber") · @T(ch,"Title")</span><progress max="100" value="@T(ch,"Readiness","0")"></progress><small>@(decimal.TryParse(T(ch,"Readiness"),out var r)?r.ToString("0"):"0")%</small></div>}<p class="muted tiny">Tính từ kết quả tự kiểm tra. Bắt đầu ôn để có dữ liệu thực tế.</p><a href="@L("plan")">Lộ trình ôn thi · VIP sắp có →</a></section><section class="panel"><h3>Nên ôn trước khi thi</h3>@foreach(var name in new[]{"Penetration Pricing","Bundle Pricing","Price Skimming"}){<div class="weak-row"><div><b>@name</b><small class="muted">Ch.4 · Pricing Strategies</small></div><a class="button small subtle" href="@L("flashcards")">Ôn lại</a><a class="tiny" href="@L("slides")">Xem slide</a></div>}</section></div><section class="panel spaced"><h3>Thành tích nhỏ</h3><div class="grid three"><div class="achievement">☼ <div><b>Mỗi ngày một bước</b><p class="muted tiny">Hoàn thành một phiên ôn để bắt đầu chuỗi.</p></div></div><div class="achievement">◎ <div><b>Bộ sưu tập case</b><p class="muted tiny">Vận dụng lý thuyết vào quyết định.</p></div></div><div class="achievement">♧ <div><b>Hiểu bài lâu hơn</b><p class="muted tiny">Quay lại ôn đúng lúc bằng flashcard.</p></div></div></div></section>
