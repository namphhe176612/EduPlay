case "vault":
<div class="filter-tabs"><button class="active" data-filter="all">Tất cả</button><button data-filter="Quiz">Tự kiểm tra</button><button data-filter="Flashcard">Flashcard</button><button data-filter="Case">Case</button><a href="@L("files")">Tài liệu riêng →</a></div><div class="grid main-side"><section class="panel"><p class="eyebrow">LỊCH SỬ HỌC TẬP</p>@foreach(var item in Model.Items){<div class="history-row" data-kind="@T(item,"Kind")"><span class="item-symbol">@(T(item,"Kind")=="Quiz"?"ϟ":T(item,"Kind")=="Case"?"◎":"▯")</span><div><small class="orange">@T(item,"Kind")</small><b>@T(item,"Title")</b><small class="muted">@T(item,"StartedAt")</small><button type="button" class="text-button" data-report="@T(item,"ContentId")">⚑ Báo cáo AI</button></div><a class="button small" href="@L(T(item,"Kind")=="Case"?"case":T(item,"Kind")=="Quiz"?"quiz":"flashcards")">Ôn lại</a></div>}@if(Model.Items.Count==0){<div class="empty"><span>▤</span><h2>Kho của bạn bắt đầu từ đây</h2><p>Mọi lần ôn, câu trả lời và case đã học sẽ được lưu ở đây.</p><a class="button" href="@L("flashcards")">Ôn bài đầu tiên →</a></div>}</section><aside class="stack"><section class="panel"><h3>Câu sai cần làm lại</h3><p class="stat-number">@Model.Extra.Count <small>câu</small></p>@foreach(var w in Model.Extra.Take(3)){<p class="tiny orange">• @T(w,"Prompt")</p><button type="button" class="text-button" data-report="@T(w,"QuestionId")">⚑ Báo cáo AI</button>}<a class="button full" href="@L("quiz")">Làm lại câu hỏi →</a></section><section class="panel"><h3>Ô lưu case</h3><p>3 ô miễn phí · tối đa 9 ô</p><p class="muted tiny">Tài liệu PDF riêng được quản lý độc lập với ô lưu kết quả case.</p><form action="/edu/buy-slot" method="post" data-confirm="Mua thêm 1 ô lưu với giá 10 coin?">@Html.AntiForgeryToken()<button class="button small" disabled="@Model.Preview">Thêm ô · 10 coin</button></form><a href="@L("wallet")">Xem ví coin →</a></section><section class="panel"><h3>EduPlay ghi nhớ về bạn</h3><p class="muted">Tiến độ từ các lần tự kiểm tra giúp bạn biết phần cần ôn thêm.</p><a href="@L("settings")">Quản lý quyền riêng tư →</a></section></aside></div>
