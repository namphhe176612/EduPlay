case "study-pack":
<div class="grid main-side learning-area"><section><div class="panel"><h3>▯ Đề cương giữa kỳ MKT101.pdf</h3><p class="muted">Bản minh họa cách đối chiếu đề cương và nội dung slide.</p></div><section class="panel"><h3>Trọng tâm theo đề cương</h3>@foreach(var (title,weight) in new[]{("Ch.4 · Pricing Strategies",38),("Ch.3 · Products & Brands",29),("Ch.2 · Marketing Environment",19),("Ch.1 · What is Marketing?",14)}){<div class="readiness-row"><span>@title</span><progress max="100" value="@weight"></progress><small>@weight%</small></div>}<div class="notice warm">Câu không tìm thấy trong slide sẽ được đánh dấu. EduPlay không tự bịa đáp án.</div></section><section class="panel"><h3>Bộ ôn theo đúng dạng đề</h3>@foreach(var (title,desc) in new[]{("Trắc nghiệm","Câu luyện cùng dạng, có giải thích và số slide"),("Tự luận ngắn","Dàn ý trả lời mẫu và từ khóa chấm điểm"),("Tình huống","Khung trả lời và case để tập viết")}){<div class="history-row"><span class="item-symbol">▯</span><div><b>@title</b><small>@desc</small></div><button class="button small" disabled>Sắp có</button></div>}</section></section><aside class="panel"><h3>Tạo bộ ôn mới</h3><div class="upload-zone compact"><span>↥</span><b>Thả đề cương / bộ câu hỏi ôn tập</b><small>PDF hoặc ảnh chụp · tính năng sắp có</small></div><label>Môn<select disabled><option>MKT101 · Principles of Marketing</option></select></label><label>Ngày thi<input type="date" disabled></label><p class="muted tiny">Chỉ dùng đề cương được phép chia sẻ. Không đoán đề thi thật.</p></aside></div>
