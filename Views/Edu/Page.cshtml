case "files":
<div class="process-strip"><div>↥ <b>1 · Tải PDF</b><small>Slide hoặc ghi chú của bạn</small></div><div>☼ <b>2 · Đọc từng trang</b><small>Trích xuất chữ từ PDF</small></div><div>▯ <b>3 · Học theo nguồn</b><small>Đọc và ghi chú riêng</small></div></div><div class="grid main-side"><section><form class="upload-zone" action="/edu/upload" method="post" enctype="multipart/form-data" id="upload-form">@Html.AntiForgeryToken()<span>↥</span><h2>Kéo thả file PDF vào đây</h2><p class="muted">Chỉ nhận PDF, tối đa 20 MB · không quá 40 trang</p><label class="button">Chọn file từ máy<input type="file" name="file" accept="application/pdf,.pdf" required id="pdf-file" hidden disabled="@Model.Preview"></label><p id="upload-name" class="tiny"></p><button type="submit" class="button gold-button" id="upload-submit" hidden>Tải tài liệu lên →</button></form><div class="panel"><div class="spread"><h3>File của bạn</h3><small class="muted">Miễn phí đến 15 trang mỗi tài liệu</small></div>@foreach(var file in Model.Items){<div class="file-row"><span class="item-symbol">▯</span><div><b>@T(file,"OriginalName")</b><small>@T(file,"PageCount") trang · chỉ mình bạn</small></div><a class="button small" href="/edu/document/@T(file,"DocumentId")" target="_blank" rel="noopener">Mở PDF</a><form action="/edu/generate-study" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@T(file,"DocumentId")"><button class="button small brown">Tạo bộ học</button></form>@if(N(file,"PageCount")>15 && N(file,"UnlockedPages")<N(file,"PageCount")){<form action="/edu/unlock-pdf" method="post" data-confirm="Mở toàn bộ trang của tài liệu này với 15 coin?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@T(file,"DocumentId")"><button class="button small brown">Mở đủ trang · 15 coin</button></form>}<form action="/edu/delete-file" method="post" data-confirm="Xóa tài liệu khỏi danh sách của bạn?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@T(file,"DocumentId")"><button class="text-button orange">Xóa</button></form></div>}@if(Model.Items.Count==0){<p class="muted">Chưa có tài liệu riêng. Tải PDF đầu tiên để bắt đầu.</p>}</div></section><aside class="stack"><section class="panel blue"><p class="eyebrow gold">♙ RIÊNG TƯ TUYỆT ĐỐI</p><p>Chỉ bạn xem được file này. File không vào thư viện chung và không ai khác truy cập được.</p><small>Bạn có thể xóa tài liệu khỏi kho bất kỳ lúc nào.</small></section><section class="panel"><h3>Chi phí</h3><p>Nội dung trong thư viện: miễn phí.</p><p class="muted">15 trang đầu được trích xuất miễn phí. Mở đến 40 trang: 15 coin, cần xác nhận trước khi thu.</p><p class="tiny gold">Xác nhận mở trang bổ sung sẽ trừ 15 coin một lần.</p></section></aside></div>
