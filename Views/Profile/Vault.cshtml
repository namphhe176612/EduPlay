@model VaultVm
@{ ViewData["Title"]="Kho sa bàn"; }
<div class="page-content"><div class="page-heading"><div><span class="eyebrow">GIỮ LẠI NHỮNG ĐIỀU ĐÁNG NHỚ</span><h1>Kho <em>sa bàn.</em></h1><p class="muted">3 chỗ lưu miễn phí · @Model.Saves.Count/3 đã dùng</p></div><a class="btn btn-outline" asp-controller="Home" asp-action="Dashboard">Về tổng quan ↗</a></div>
@if(Model.Saves.Count==0){<div class="empty-state"><span>▱</span><h3>Chưa có kết quả được lưu.</h3><p>Sau khi hoàn thành một lượt chơi, chọn “Lưu vào kho” trên trang kết quả.</p></div>}
else{<div class="scenario-grid">@foreach(var save in Model.Saves){var run=Model.Runs.Single(x=>x.RunId==save.RunId);<article class="scenario-card"><div class="card-top"><span class="tag">ĐÃ LƯU</span><span class="muted">@save.SavedAt.ToString("dd/MM/yyyy")</span></div><span class="scenario-symbol">▱</span><h3>@save.Title</h3><p>@run.Score?.ToString("0.#") điểm đã chấm</p><div class="button-row"><a class="btn btn-dark btn-small" asp-controller="Scenarios" asp-action="Results" asp-route-id="@save.RunId">Xem kết quả ↗</a><form asp-controller="Scenarios" asp-action="Start" method="post"><input type="hidden" name="id" value="@run.ScenarioId" /><button class="btn btn-outline btn-small" type="submit">↻ Chơi lại</button></form></div><form asp-action="DeleteSave" method="post" data-confirm="Xóa mục lưu này? Lượt chơi gốc vẫn được giữ trong lịch sử."><input type="hidden" name="id" value="@save.SaveId" /><label class="check-label"><input type="checkbox" name="confirm" value="true" required /><span>Tôi muốn xóa mục lưu này.</span></label><button class="quiet-button danger-text" type="submit">Xóa khỏi kho</button></form></article>}</div>}</div>

