@model ResultsVm
@{ ViewData["Title"]="Kết quả"; var data=Model.Scenario.Data; }
<div class="page-content"><a class="back-link" asp-controller="Home" asp-action="Dashboard">← Không gian học tập</a>
<section class="result-hero"><div><span class="eyebrow">BẠN VỪA HOÀN THÀNH MỘT TRẢI NGHIỆM</span><h1>Quyết định đã qua.<br /><em>Bài học ở lại.</em></h1><p>@Model.Scenario.Title · @data.Company</p></div><div class="score-ring"><strong>@Model.Run.Score?.ToString("0.#")</strong><span>/ 80 điểm đã chấm</span></div></section>
@if(data.IsDemo){<div class="pill-note">Kết quả demo theo mẫu, không đánh giá năng lực Marketing thực tế.</div>}
<div class="result-metrics">@for(var i=0;i<data.Metrics.Count;i++){<div><span>@data.Metrics[i].Name</span><strong>@Model.Metrics[i] <small>/ 100</small></strong></div>}</div>
<p class="form-note">Quyết định: @Model.DecisionScore/60 · Chỉ số mô phỏng: @Model.BusinessScore/20. Chưa chấm 20 điểm lập luận bằng AI; không tự cộng điểm hoặc thưởng coin hoàn thành.</p>
<div class="button-row"><form asp-action="Start" method="post"><input type="hidden" name="id" value="@Model.Scenario.ScenarioId" /><button class="btn btn-dark" type="submit">↻ Chơi lại · miễn phí</button></form>
@if(!Model.IsSaved){<form asp-action="Save" method="post"><input type="hidden" name="id" value="@Model.Run.RunId" /><button class="btn btn-outline" type="submit">＋ Lưu vào kho</button></form>}else{<a class="btn btn-outline" asp-controller="Profile" asp-action="Vault">✓ Đã lưu vào kho</a>}
<a class="btn btn-outline" asp-action="Details" asp-route-id="@Model.Scenario.ScenarioId">Luyện tập sâu ↗</a></div>
<div class="section-heading"><h2>Nhìn lại từng quyết định</h2><span class="muted">Nguồn luôn ở ngay bên cạnh</span></div>
@foreach(var selected in Model.Run.Choices.OrderBy(x=>x.StepNumber)){var scene=data.Scenes[selected.StepNumber-1]; var decision=scene.Choices.Single(x=>x.Key==selected.Choice);<details open><summary>@selected.StepNumber.ToString("00") · @scene.Topic <span class="quality-label @decision.Quality">@(decision.Quality=="good"?"Có căn cứ":decision.Quality=="mixed"?"Có đánh đổi":"Cần ôn")</span></summary><div class="details-body"><strong>Bạn chọn @decision.Key · @decision.Text</strong><p>@decision.Outcome</p><p><strong>Vì sao:</strong> @decision.Why</p><blockquote>@scene.SourceQuote</blockquote><a class="source-chip" asp-controller="Documents" asp-action="Details" asp-route-id="@Model.Scenario.FileId" asp-route-page="@scene.SourceSlide" target="_blank" rel="noopener">▤ Mở slide @scene.SourceSlide ↗</a><details class="alternative-details"><summary>Khám phá các phương án còn lại</summary><div class="details-body">@foreach(var other in scene.Choices.Where(c=>c.Key!=decision.Key)){<p><strong>@other.Key · @other.Text</strong><br />@other.Outcome<br /><span class="muted">@other.Why</span></p>}</div></details></div></details>}
<section class="panel"><span class="eyebrow">HỎI ĐỂ HIỂU SÂU HƠN</span><h2>Đối chiếu cùng nguồn.</h2><p>3 câu hỏi đầu mỗi sa bàn miễn phí; sau đó 1 coin/câu. Demo chỉ tìm trích đoạn, luôn miễn phí.</p>
@foreach(var m in Model.Messages){<article class="chat-item"><strong>Bạn: @m.Question</strong><p>@m.Answer</p><a class="source-chip" asp-controller="Documents" asp-action="Details" asp-route-id="@Model.Scenario.FileId" asp-route-page="@m.SourceSlide" target="_blank" rel="noopener">▤ Nguồn: slide @m.SourceSlide ↗</a></article>}
<form asp-action="Ask" method="post" data-ai><input type="hidden" name="id" value="@Model.Run.RunId" /><label for="question">Bạn muốn làm rõ điều gì?</label><textarea name="question" id="question" maxlength="1000" required placeholder="Giải thích lại căn cứ của lựa chọn này trong slide..."></textarea><button class="btn btn-dark" type="submit">Gửi câu hỏi ↗</button><div class="busy-box" role="status"><span class="spinner"></span>Đang đối chiếu nội dung… <button type="button" class="quiet-button" data-cancel>Dừng</button></div></form></section>
<section class="panel"><h3>Trải nghiệm này hữu ích với bạn chứ?</h3><form asp-action="Rate" method="post" class="rating-row"><input type="hidden" name="id" value="@Model.Run.RunId" /><label for="rating">Đánh giá</label><select id="rating" name="rating">@for(var star=1;star<=5;star++){<option value="@star" selected="@(Model.Run.Rating==star)">@star / 5 sao</option>}</select><button class="btn btn-outline btn-small" type="submit">Gửi đánh giá</button></form></section></div>

