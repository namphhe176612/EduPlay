@model PlayVm
@{ ViewData["Title"]="Vào vai"; var data=Model.Scenario.Data; var scene=data.Scenes[Model.Step]; }
<div class="page-content"><nav class="breadcrumb"><a asp-controller="Home" asp-action="Dashboard">Không gian học tập</a><span>/</span><a asp-action="Details" asp-route-id="@Model.Scenario.ScenarioId">@Model.Scenario.Title</a><span>/ Vào vai</span></nav>
<div class="page-heading"><div><span class="eyebrow">BẠN LÀ @data.Role.ToUpperInvariant()</span><h1>Một quyết định.<br /><em>Nhiều điều để học.</em></h1></div><span class="tag">TÌNH HUỐNG @(Model.Step+1) / @data.Scenes.Count</span></div>
@if(data.IsDemo){<div class="pill-note">Demo theo mẫu · Hậu quả minh họa, không phải kết quả dự báo.</div>}
<div class="progress-steps" aria-label="Tiến độ @Model.Run.Choices.Count trên @data.Scenes.Count">@for(var i=0;i<data.Scenes.Count;i++){<span class="@(i<Model.Run.Choices.Count?"done":"")"></span>}</div>
<div class="play-shell"><section><article class="scene-card"><div class="message-header"><span class="avatar mint">L</span><div><strong>@scene.Sender</strong><small>@scene.Channel · Tình huống @(Model.Step+1)</small></div><button class="quiet-button" type="button" data-listen="#scene-message" data-language="@(data.IsDemo?"vi-VN":"auto")">▶ Nghe</button></div><div id="scene-message" class="scene-message">@scene.Message</div><a class="source-chip" asp-controller="Documents" asp-action="Details" asp-route-id="@Model.Scenario.FileId" asp-route-page="@scene.SourceSlide" target="_blank" rel="noopener">▤ Slide @scene.SourceSlide · Xem nguồn ↗</a>
@if(!Model.ShowOutcome){<div class="choices">@foreach(var c in scene.Choices){<form asp-action="Choose" method="post"><input type="hidden" name="id" value="@Model.Run.RunId" /><input type="hidden" name="step" value="@(Model.Step+1)" /><input type="hidden" name="choice" value="@c.Key" /><button class="choice-button" type="submit"><span class="choice-key">@c.Key</span><span>@c.Text</span></button></form>}</div><p class="form-note">Chọn một phương án. Lựa chọn sẽ được lưu và khóa cho tình huống này.</p>}
else{<div class="selected-choice">✓ Bạn đã chọn <strong>@Model.Selected!.Key</strong> · @Model.Selected.Text</div><section class="outcome-card @Model.Selected.Quality"><span class="tiny-label">HAI TUẦN SAU · HẬU QUẢ MÔ PHỎNG</span><h3>@(Model.Selected.Quality=="good"?"Một lựa chọn có căn cứ":Model.Selected.Quality=="mixed"?"Một quyết định có đánh đổi":"Một giả định cần xem lại")</h3><p>@Model.Selected.Outcome</p><strong>Vì sao?</strong><p>@Model.Selected.Why</p><blockquote>@scene.SourceQuote</blockquote></section><a class="btn btn-dark full" asp-action="Play" asp-route-id="@Model.Run.RunId">@(Model.Run.Status=="Completed"?"Xem kết quả →":"Tình huống tiếp theo →")</a>}
</article></section><aside class="sticky"><section class="panel"><span class="eyebrow">BẢNG ĐIỀU KHIỂN</span><h3>@data.Company</h3><p>Chỉ số mô phỏng · thang 0–100</p><div class="metric-list">@for(var i=0;i<data.Metrics.Count;i++){<div class="metric-item"><div><span>@data.Metrics[i].Name</span><strong>@Model.Metrics[i]</strong></div><progress value="@Model.Metrics[i]" max="100" aria-label="@data.Metrics[i].Name"></progress></div>}</div></section><div class="pill-note">Không có đáp án “miễn phí”. Mỗi quyết định đều có thể có đánh đổi; hãy cân nhắc căn cứ trong slide.</div><a asp-controller="Home" asp-action="Help" class="back-link">ⓘ Hướng dẫn & thuật ngữ</a></aside></div></div>

