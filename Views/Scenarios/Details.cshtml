@model Scenario
@{ ViewData["Title"]=Model.Title; var data=Model.Data; }
<div class="page-content narrow"><a class="back-link" asp-controller="Home" asp-action="Dashboard">← Không gian học tập</a><span class="eyebrow">SA BÀN CỦA BẠN ĐÃ SẴN SÀNG</span><h1>@Model.Title</h1>
@if(data.IsDemo){<div class="pill-note"><strong>Demo theo mẫu · 0 coin</strong> — Nội dung minh họa luồng học, chưa phải kịch bản do AI sinh.</div>}
<section class="panel"><div class="button-row"><span class="tag">@data.Company</span><span class="tag">@data.Role</span><span class="tag">@data.Scenes.Count tình huống</span></div><h2 class="section-heading">Bạn sẽ vào vai ai?</h2><p>@data.Premise</p><div class="result-metrics">@foreach(var m in data.Metrics){<div><span>@m.Name</span><strong>@m.Initial <small>/ 100</small></strong></div>}</div><form asp-action="Start" method="post"><input type="hidden" name="id" value="@Model.ScenarioId" /><button class="btn btn-dark" type="submit">Vào vai · miễn phí ▶</button></form></section>
<div class="two-col"><section class="panel"><h3>Hành trình của bạn</h3>@for(var i=0;i<data.Scenes.Count;i++){<p><strong>0@(i+1)</strong> · @data.Scenes[i].Topic</p>}<a class="source-chip" asp-controller="Documents" asp-action="Details" asp-route-id="@Model.FileId">▤ Xem lại tài liệu gốc ↗</a></section>
<section class="panel"><h3>Luyện tập từ tài liệu</h3><p>Chọn chủ đề để củng cố kiến thức. Một lượt/ngày tới 6 câu miễn phí; sau đó 1 coin/3 câu. Chế độ demo luôn miễn phí.</p><form asp-controller="Practice" asp-action="Create" method="post" data-ai><input type="hidden" name="scenarioId" value="@Model.ScenarioId" /><label for="focus">Phần muốn tập trung</label><input name="focus" id="focus" maxlength="200" placeholder="Ví dụ: phân khúc khách hàng" /><label for="count">Số câu hỏi</label><select name="count" id="count"><option>3</option><option selected>6</option><option>9</option><option>12</option><option>15</option><option>20</option></select><button class="btn btn-outline full" type="submit">Tạo bài luyện tập ↗</button><div class="busy-box" role="status"><span class="spinner"></span>Đang tạo câu hỏi… <button type="button" class="quiet-button" data-cancel>Dừng</button></div></form></section></div>
</div>

