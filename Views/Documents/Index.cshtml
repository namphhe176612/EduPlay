@model List<LectureFile>
@{ ViewData["Title"]="Tài liệu của tôi"; }
<div class="page-content"><div class="page-heading"><div><span class="eyebrow">THƯ VIỆN RIÊNG TƯ</span><h1>Tài liệu của tôi<span class="brand-dot">.</span></h1><p class="muted">Mỗi bài giảng là điểm khởi đầu cho một trải nghiệm.</p></div><a class="btn btn-dark" asp-action="Upload">＋ Nạp PDF mới</a></div>
<div class="pill-note">⌁ Chỉ bạn có quyền mở nội dung PDF và slide của mình, kể cả khi hệ thống có quản trị viên.</div>
@if(Model.Count==0){<div class="empty-state"><span>▤</span><h3>Thư viện còn trống.</h3><p>Nạp một PDF bài giảng để bắt đầu học qua tình huống.</p><a class="btn btn-dark" asp-action="Upload">Nạp PDF đầu tiên ↗</a></div>}
@foreach(var f in Model){<a class="document-row" asp-action="Details" asp-route-id="@f.FileId"><span class="pdf-icon">PDF</span><div><strong>@f.FileName</strong><small>@f.TotalPages trang · @f.Language · @f.UploadedAt.ToString("dd/MM/yyyy")</small></div><span>Xem nguồn ↗</span></a>}
</div>

