@model AdminVm
@{ ViewData["Title"]="Quản trị"; }
<div class="page-content"><div class="page-heading"><div><span class="eyebrow">ADMIN CONSOLE</span><h1>Tổng quan <em>hệ thống.</em></h1><p class="muted">Quản lý hoạt động, giữ riêng tư cho nội dung của người học.</p></div><span class="tag">ROLE 2 · ADMIN</span></div>
<div class="stat-grid"><div class="stat-card"><span>TÀI KHOẢN TRONG KẾT QUẢ</span><strong>@Model.Users.Count</strong><p>Tối đa 100 theo bộ lọc</p></div><div class="stat-card"><span>TÀI LIỆU ĐÃ NẠP</span><strong>@Model.FileCount</strong><p>Chỉ đếm, không mở nội dung</p></div><div class="stat-card"><span>LƯỢT CHƠI</span><strong>@Model.RunCount</strong><p>Tất cả trạng thái</p></div><div class="stat-card mint-card"><span>AI COST · 200 CALL MỚI NHẤT</span><strong>$@Model.Calls.Sum(x=>x.CostUSD).ToString("0.0000")</strong><p>Demo = 0; giá/token theo cấu hình</p></div></div>
<section class="panel"><div class="section-heading"><h2>Người dùng & coin</h2><span class="tag">MỌI THAY ĐỔI ĐỀU CÓ AUDIT</span></div><form method="get" class="button-row"><label for="search">Tìm tài khoản</label><input id="search" name="search" value="@ViewData["Search"]" placeholder="Tên hoặc email" /><button type="submit" class="btn btn-outline btn-small">Tìm kiếm</button></form><div class="table-wrap"><table><thead><tr><th>TÀI KHOẢN</th><th>VAI TRÒ</th><th>COIN</th><th>TRẠNG THÁI</th><th>ĐIỀU CHỈNH</th></tr></thead><tbody>@foreach(var u in Model.Users){<tr><td><strong>@u.FullName</strong><br />@u.Email</td><td>@(u.Role==2?"Admin":"User")</td><td>@u.Coin</td><td>@(u.IsLocked?"Đã khóa":"Hoạt động")</td><td>@if(u.Role==1){<form asp-action="AdjustCoins" method="post" class="admin-form"><input type="hidden" name="id" value="@u.UserId" /><input type="number" name="amount" placeholder="± coin" aria-label="Số coin điều chỉnh" min="-100000" max="100000" required /><input name="reason" placeholder="Lý do điều chỉnh" aria-label="Lý do điều chỉnh coin" maxlength="200" required /><button class="btn btn-outline btn-small" type="submit">Ghi sổ</button></form><form asp-action="ToggleLock" method="post" class="admin-form"><input type="hidden" name="id" value="@u.UserId" /><input name="reason" placeholder="Lý do khóa/mở khóa" aria-label="Lý do đổi trạng thái" maxlength="300" required /><button class="btn btn-outline btn-small" type="submit">@(u.IsLocked?"Mở khóa":"Khóa")</button></form>}</td></tr>}</tbody></table></div></section>
<section class="panel"><h2>AI usage · 200 bản ghi mới nhất</h2><div class="table-wrap"><table><thead><tr><th>THỜI GIAN UTC</th><th>FEATURE</th><th>PROVIDER / MODEL</th><th>TOKEN VÀO / RA</th><th>USD</th><th>COIN</th><th>TRẠNG THÁI</th></tr></thead><tbody>@foreach(var call in Model.Calls){<tr><td>@call.CreatedAt.ToString("dd/MM HH:mm")</td><td>@call.FeatureName</td><td>@call.AiProvider / @call.AiModel</td><td>@call.InputTokens / @call.OutputTokens</td><td>@call.CostUSD.ToString("0.000000")</td><td>@call.CoinCharged</td><td>@(call.IsSuccess?"Thành công":"Không thành công")</td></tr>}</tbody></table></div></section>
<section class="panel"><h2>Thanh toán · 200 bản ghi mới nhất</h2><p>Dữ liệu hiện có trong SQL. Cổng thanh toán thật chưa kết nối, không có nút tự xác nhận trả tiền.</p><div class="table-wrap"><table><thead><tr><th>MÃ</th><th>USER</th><th>GÓI</th><th>VNĐ</th><th>COIN</th><th>PHƯƠNG THỨC</th><th>TRẠNG THÁI</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td>@p.PaymentId</td><td>@p.UserId</td><td>@p.PackageName</td><td>@p.AmountVND.ToString("N0")</td><td>@p.CoinAmount</td><td>@p.PaymentMethod</td><td>@p.Status</td></tr>}</tbody></table></div></section>
<section class="panel"><h2>Audit log · 100 bản ghi mới nhất</h2><div class="table-wrap"><table><thead><tr><th>THỜI GIAN UTC</th><th>ADMIN</th><th>HÀNH ĐỘNG</th><th>USER</th><th>LÝ DO</th></tr></thead><tbody>@foreach(var log in Model.Logs){<tr><td>@log.CreatedAt.ToString("dd/MM HH:mm")</td><td>@log.AdminUserId</td><td>@log.Action</td><td>@log.TargetUserId</td><td>@log.Description</td></tr>}</tbody></table></div></section></div>

