@model DashboardVm
@{ ViewData["Title"]="Tổng quan"; var done=Model.Runs.Count(x=>x.Status=="Completed"); }
<div class="page-content">
<div class="page-heading"><div><span class="eyebrow">KHÔNG GIAN CỦA BẠN</span><h1>Chào @Model.User.FullName.Split(' ').Last(),<br />hôm nay mình <em>thực hành</em> nhé.</h1><p class="muted">Một quyết định nhỏ. Một bài học đáng nhớ.</p></div><a class="btn btn-dark" asp-controller="Documents" asp-action="Upload">＋ Nạp PDF mới</a></div>
<div class="stat-grid"><div class="stat-card"><span>TÀI LIỆU CỦA TÔI</span><strong>@Model.Files.Count<small> PDF</small></strong><p>Nguồn kiến thức riêng của bạn</p></div><div class="stat-card"><span>SA BÀN ĐÃ DỰNG</span><strong>@Model.Scenarios.Count<small> kịch bản</small></strong><p>Sẵn sàng để vào vai</p></div><div class="stat-card"><span>LƯỢT HOÀN THÀNH</span><strong>@done<small> lượt</small></strong><p>Tiến bộ từ mỗi quyết định</p></div><a class="stat-card mint-card" asp-controller="Wallet" asp-action="Index"><span>VÍ CỦA BẠN ↗</span><strong>@Model.User.Coin<small> coin</small></strong><p>Chi phí rõ ràng trước mỗi thao tác</p></a></div>
<section class="start-banner"><div><span class="tiny-label">TỪ SLIDE ĐẾN TÌNH HUỐNG</span><h2>Đừng để bài giảng chỉ nằm trong thư mục.</h2><p>Nạp PDF, nhận một vai trò và thử áp dụng điều vừa học.</p></div><a class="btn btn-dark" asp-controller="Documents" asp-action="Upload">Bắt đầu một sa bàn ↗</a><span class="banner-shape" aria-hidden="true">↗</span></section>
<div class="section-heading"><h2>Sa bàn gần đây <span class="count-chip">@Model.Scenarios.Count</span></h2><a asp-controller="Profile" asp-action="Vault">Kho kết quả →</a></div>
@if(Model.Scenarios.Count==0){<div class="empty-state"><span>▱</span><h3>Trang đầu tiên đang chờ bạn.</h3><p>Sa bàn sẽ xuất hiện tại đây sau khi bạn nạp PDF và dựng kịch bản đầu tiên.</p><a asp-controller="Documents" asp-action="Upload" class="btn btn-outline">Nạp tài liệu đầu tiên ↗</a></div>}
else {<div class="scenario-grid">@foreach(var s in Model.Scenarios.Take(6)){<article class="scenario-card"><div class="card-top"><span class="tag">@(s.AiModel=="demo-local-v1"?"DEMO · MIỄN PHÍ":"SA BÀN")</span><span class="muted">@s.CreatedAt.ToString("dd/MM/yyyy")</span></div><span class="scenario-symbol">⌘</span><h3>@s.Title</h3><p>@s.CompanyName · @s.RoleName</p><div class="card-bottom"><span>@(Model.Runs.Count(x=>x.ScenarioId==s.ScenarioId)) lượt chơi</span><a asp-controller="Scenarios" asp-action="Details" asp-route-id="@s.ScenarioId">Vào vai ↗</a></div></article>}</div>}
<div class="section-heading"><h2>Tài liệu mới nhất</h2><a asp-controller="Documents" asp-action="Index">Xem tất cả →</a></div>
@foreach(var f in Model.Files.Take(3)){<a class="document-row" asp-controller="Documents" asp-action="Details" asp-route-id="@f.FileId"><span class="pdf-icon">PDF</span><div><strong>@f.FileName</strong><small>@f.TotalPages trang · @f.UploadedAt.ToString("dd/MM/yyyy")</small></div><span>↗</span></a>}
</div>

